<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PixelSlim</title>
<script type="module">
window.heicModuleReady=(async()=>{
  const sources=[
    "https://cdn.jsdelivr.net/npm/heic-to@1.6.5/+esm",
    "https://esm.sh/heic-to@1.6.5"
  ];
  let lastError;
  for(const source of sources){
    try{
      const module=await import(source);
      const converter=module.heicTo||module.default;
      if(typeof converter==="function"){window.heicToConverter=converter;return converter}
    }catch(error){lastError=error;console.warn("Nie udało się załadować HEIC:",source,error)}
  }
  throw lastError||new Error("Nie udało się załadować modułu HEIC");
})();
</script><script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script><script src="https://cdn.jsdelivr.net/npm/piexifjs@1.0.6/piexif.min.js"></script>
<style>:root{--b:#009fe3;--n:#003f7f;--p:#eef7fc;--t:#30343b;--m:#66727f;--d:#c73542}*{box-sizing:border-box}body{margin:0;font:16px Arial;color:var(--t)}header{height:82px;display:flex;align-items:center;gap:36px;padding:0 5%;border-bottom:1px solid #ddd}.logo{font-size:34px;font-weight:900;font-style:italic;color:var(--b)}nav{margin-left:auto;display:flex;gap:28px}nav a{color:#333;text-decoration:none}.safe{background:var(--n);color:#fff;padding:16px 22px;font-weight:bold}.hero{min-height:390px;padding:70px 5% 110px;color:#fff;background:linear-gradient(120deg,var(--b),#006eb5 48%,var(--n))}.hero h1{font-size:clamp(40px,5vw,68px);font-style:italic;text-transform:uppercase;margin:0 0 20px}.hero p{font-size:21px;max-width:850px;line-height:1.55}.main{max-width:1180px;margin:-64px auto 0;padding:0 22px}.drop{border-top:7px solid var(--b);background:#fff;padding:40px;text-align:center;box-shadow:0 10px 34px #003f7f2e;cursor:pointer}.drop.over{background:var(--p)}.icon{margin:auto;width:60px;height:60px;display:grid;place-items:center;background:var(--b);color:#fff;font-size:32px}.btn{padding:13px 20px;border:0;background:var(--n);color:#fff;font-weight:bold;cursor:pointer}.drop .btn{margin-top:18px}.workspace{display:none;grid-template-columns:320px 1fr;gap:22px;margin-top:25px}.card{border:1px solid #d5e2eb;padding:24px;box-shadow:0 5px 20px #003f7f14}.card h3{color:var(--n);border-bottom:3px solid var(--b);padding-bottom:12px}.field{margin-bottom:18px}.field label{display:flex;justify-content:space-between;font-weight:bold;margin-bottom:7px}select,input[type=number]{width:100%;padding:11px;border:1px solid #b9cbd8}input[type=range]{width:100%;accent-color:var(--b)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.checks{display:grid;gap:10px;color:#52606c}.actions{display:grid;gap:10px;margin-top:24px}.secondary{background:#fff;color:var(--n);border:2px solid var(--n)}.danger{background:#fff;color:var(--d);border:2px solid #e7b8bd}.files{display:grid;gap:10px}.file{display:grid;grid-template-columns:70px 1fr auto;gap:14px;align-items:center;padding:11px;background:#f5f9fc;border-left:5px solid var(--b)}.thumb{width:70px;height:56px;object-fit:cover}.name{font-weight:bold;color:var(--n)}.meta,.status{font-size:12px;color:var(--m)}.err{color:var(--d)}.ok{color:#067b55}.progress{height:5px;background:#d9e5ec}.progress i{display:block;height:100%;background:var(--b)}.row{display:flex;gap:10px}.remove{border:0;background:none;color:var(--d);font-weight:bold;cursor:pointer}.notice{display:none;margin-top:16px;padding:12px;background:#fff3cd}.hint{font-size:11px;color:var(--m);margin-left:25px}@media(max-width:850px){nav{display:none}.workspace{grid-template-columns:1fr}.safe{display:none}}</style></head>
<body><header><div class="logo">PIXELSLIM</div><nav><a href="#drop">Konwersja</a><a href="#workspace">Ustawienia</a><a href="#workspace">Formaty</a></nav><div class="safe">● Przetwarzanie lokalne</div></header><section class="hero"><h1>Zmniejsz i konwertuj.</h1><p>Kompresuj zdjęcia HEIC, JPEG, PNG i WebP, zmieniaj ich wymiary oraz zachowuj metadane bez wysyłania plików na serwer.</p></section><main class="main"><section id="drop" class="drop" tabindex="0"><div class="icon">⇧</div><h2>Dodaj zdjęcia do konwersji</h2><p>Przeciągnij pliki tutaj lub wybierz je z urządzenia</p><button class="btn">Wybierz zdjęcia</button><input id="picker" type="file" accept="image/*,.heic,.heif" multiple hidden></section><div id="notice" class="notice"></div><section id="workspace" class="workspace"><aside class="card"><h3>Ustawienia eksportu</h3><div class="field"><label>Format docelowy</label><select id="format"><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option><option value="image/png">PNG</option></select></div><div class="field" id="qf"><label><span>Jakość</span><span id="qt">82%</span></label><input id="quality" type="range" min="20" max="100" value="82"></div><div class="field"><label>Maksymalne wymiary</label><div class="grid"><input id="mw" type="number" min="1" max="16384" value="1920"><input id="mh" type="number" min="1" max="16384" value="1920"></div></div><div class="field"><label>Docelowy rozmiar (KB)</label><input id="target" type="number" min="1" placeholder="np. 500"></div><div class="checks"><label><input id="noUp" type="checkbox" checked> Nie powiększaj małych zdjęć</label><label><input id="names" type="checkbox" checked> Zachowaj nazwy plików</label><label><input id="exif" type="checkbox" checked> Zachowaj EXIF</label><div class="hint">EXIF: JPEG → JPEG</div></div><div class="actions"><button id="process" class="btn">Kompresuj i konwertuj</button><button id="zip" class="btn secondary" disabled>Pobierz ZIP</button><button id="clear" class="btn danger">Usuń wszystkie</button></div></aside><section class="card"><h3>Wybrane zdjęcia <span id="stats"></span></h3><div id="list" class="files"></div></section></section></main>
<script>const S={a:[]},$=x=>document.getElementById(x),drop=$('drop'),pick=$('picker'),list=$('list');const fb=n=>n<1024?n+' B':n<1048576?(n/1024).toFixed(1)+' KB':(n/1048576).toFixed(2)+' MB';const ext=t=>t==='image/png'?'png':t==='image/webp'?'webp':'jpg';$('quality').oninput=e=>$('qt').textContent=e.target.value+'%';$('format').onchange=()=>{let p=$('format').value==='image/png';$('quality').disabled=p;$('qf').style.opacity=p?.5:1};drop.onclick=()=>pick.click();pick.onchange=e=>add(e.target.files);['dragenter','dragover'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.add('over')}));['dragleave','drop'].forEach(v=>drop.addEventListener(v,e=>{e.preventDefault();drop.classList.remove('over')}));drop.addEventListener('drop',e=>add(e.dataTransfer.files));function add(fs){let a=[...fs].filter(f=>f.type.startsWith('image/')||/\.(heic|heif)$/i.test(f.name));if(!a.length){$('notice').style.display='block';$('notice').textContent='Brak obsługiwanych plików';return}a.forEach(f=>S.a.push({id:crypto.randomUUID(),f,s:'Gotowy'}));$('workspace').style.display='grid';render()}async function src(o){
  const isHeic=/\.(heic|heif)$/i.test(o.f.name)||/heic|heif/i.test(o.f.type);
  if(!isHeic)return o.f;
  try{
    const converter=window.heicToConverter||await window.heicModuleReady;
    if(typeof converter!=="function")throw Error("Nieprawidłowy moduł HEIC");
    return await converter({blob:o.f,type:"image/jpeg",quality:.95});
  }catch(error){
    console.error("HEIC:",error);
    throw Error("Nie udało się załadować modułu HEIC. Sprawdź internet i blokady cdn.jsdelivr.net lub esm.sh.");
  }
}
async function prev(o){if(o.p)return o.p;o.p=URL.createObjectURL(await src(o));return o.p}function render(){list.innerHTML='';let a=0,b=0;S.a.forEach(o=>{a+=o.f.size;b+=o.out?.size||0;let d=document.createElement('div');d.className='file';d.innerHTML=`<img id="i${o.id}" class="thumb"><div><div class="name">${o.f.name}</div><div class="meta">${fb(o.f.size)}${o.out?' → '+fb(o.out.size):''}</div><div class="status ${o.e?'err':o.out?'ok':''}">${o.e||o.s}</div><div class="progress"><i style="width:${o.pr||0}%"></i></div></div><div class="row">${o.u?`<a href="${o.u}" download="${o.n}">Pobierz</a>`:''}<button class="remove" onclick="removeItem('${o.id}')">Usuń</button></div>`;list.appendChild(d);prev(o).then(u=>{let i=$('i'+o.id);if(i)i.src=u}).catch(e=>{o.e=e.message})});$('stats').textContent=`${S.a.length} • ${fb(a)}${b?' → '+fb(b):''}`;$('zip').disabled=!S.a.some(o=>o.out)}window.removeItem=id=>{let i=S.a.findIndex(o=>o.id===id);if(i<0)return;let o=S.a[i];if(o.u)URL.revokeObjectURL(o.u);if(o.p)URL.revokeObjectURL(o.p);S.a.splice(i,1);$('workspace').style.display=S.a.length?'grid':'none';render()};const cb=(c,t,q)=>new Promise((r,j)=>c.toBlob(b=>b?r(b):j(Error('Błąd zapisu')),t,q));const du=b=>new Promise((r,j)=>{let f=new FileReader;f.onload=()=>r(f.result);f.onerror=j;f.readAsDataURL(b)});function bd(u){let [h,d]=u.split(','),x=atob(d),a=new Uint8Array(x.length);for(let i=0;i<x.length;i++)a[i]=x.charCodeAt(i);return new Blob([a],{type:(h.match(/:(.*?);/)||[])[1]||'image/jpeg'})}async function meta(f,b,w,h){if(!$('exif').checked||$('format').value!=='image/jpeg'||(!/jpe?g/i.test(f.type)&&!/\.jpe?g$/i.test(f.name)))return b;try{let x=piexif.load(await du(f));x['0th'][piexif.ImageIFD.Orientation]=1;if(x.Exif){x.Exif[piexif.ExifIFD.PixelXDimension]=w;x.Exif[piexif.ExifIFD.PixelYDimension]=h}x.thumbnail=null;return bd(piexif.insert(piexif.dump(x),await du(b)))}catch{return b}}async function conv(o){o.e='';o.s='Przetwarzanie';o.pr=15;render();let u;try{let b=await src(o);u=URL.createObjectURL(b);let im=await new Promise((r,j)=>{let x=new Image;x.onload=()=>r(x);x.onerror=j;x.src=u});let sc=Math.min((+$('mw').value||im.width)/im.width,(+$('mh').value||im.height)/im.height);if($('noUp').checked)sc=Math.min(1,sc);let c=document.createElement('canvas');c.width=Math.max(1,Math.round(im.width*sc));c.height=Math.max(1,Math.round(im.height*sc));let x=c.getContext('2d');if($('format').value==='image/jpeg'){x.fillStyle='#fff';x.fillRect(0,0,c.width,c.height)}x.drawImage(im,0,0,c.width,c.height);let q=+$('quality').value/100,out=await cb(c,$('format').value,q),t=(+$('target').value||0)*1024;while(t&&out.size>t&&q>.12&&$('format').value!=='image/png'){q-=.07;out=await cb(c,$('format').value,q)}out=await meta(o.f,out,c.width,c.height);o.n=($('names').checked?o.f.name.replace(/\.[^.]+$/,''):'zdjecie-'+(S.a.indexOf(o)+1))+'.'+ext($('format').value);o.out=out;if(o.u)URL.revokeObjectURL(o.u);o.u=URL.createObjectURL(out);o.s=`Gotowe • ${c.width}×${c.height}`;o.pr=100}catch(e){o.e='Błąd: '+(e.message||e);o.pr=0}finally{if(u)URL.revokeObjectURL(u);render()}}$('process').onclick=async()=>{let b=$('process');b.disabled=true;try{for(let o of S.a)await conv(o)}finally{b.disabled=false}};$('zip').onclick=async()=>{let z=new JSZip;S.a.filter(o=>o.out).forEach(o=>z.file(o.n,o.out));let b=await z.generateAsync({type:'blob'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='zdjecia.zip';a.click()};$('clear').onclick=()=>{S.a.forEach(o=>{if(o.u)URL.revokeObjectURL(o.u);if(o.p)URL.revokeObjectURL(o.p)});S.a=[];$('workspace').style.display='none';render()};</script></body></html>
